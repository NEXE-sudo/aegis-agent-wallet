# Generate distinct, random local secrets; never commit actual values.
AEGIS_AGENT_TOKEN=replace-with-a-long-random-agent-token
AEGIS_APPROVAL_TOKEN=replace-with-a-different-long-random-owner-token
AEGIS_API_URL=http://127.0.0.1:8000
AEGIS_DB_PATH=./aegis-workflow.sqlite3
AEGIS_APPROVAL_EXPIRES_SECONDS=300
AEGIS_EXECUTION_MODE=simulated
BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc-provider.example
# Set only for vault-only Base Sepolia execution; never commit an actual key.
# AEGIS_TESTNET_PRIVATE_KEY=
# Optional OpenAI-compatible provider settings; leave all unset for offline mode.
# AEGIS_LLM_BASE_URL=https://your-provider.example/v1
# AEGIS_LLM_MODEL=your-model
# AEGIS_LLM_API_KEY=
